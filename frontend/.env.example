NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_RAZORPAY_KEY=your_razorpay_key_id

# Shared secret used by the backend to trigger on-demand ISR
# revalidation via /api/revalidate. Must match REVALIDATE_SECRET in the
# backend .env. If left blank, ISR will still work — pages just refresh
# on their natural TTL instead of instantly.
REVALIDATE_SECRET=change_me_to_a_long_random_string
